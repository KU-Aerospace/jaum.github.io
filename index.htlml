<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>초성 ⚡ 스피드핵</title>
    <style>
        :root {
            --primary: #00ff88;
            --bg: #0a0a0a;
            --card: #1a1a1a;
            --text: #ffffff;
        }

        body {
            font-family: 'Pretendard', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* 헤더 고정 */
        .header {
            position: sticky;
            top: 0;
            background: rgba(10, 10, 10, 0.9);
            backdrop-filter: blur(10px);
            padding: 15px;
            z-index: 100;
            border-bottom: 1px solid #333;
        }

        .search-wrapper {
            position: relative;
            display: flex;
            gap: 10px;
        }

        #searchInput {
            width: 100%;
            padding: 15px;
            font-size: 18px;
            background: var(--card);
            border: 2px solid #333;
            border-radius: 12px;
            color: white;
            outline: none;
        }

        #searchInput:focus { border-color: var(--primary); }

        /* 결과 리스트 디자인 (가독성 극대화) */
        .result-container {
            padding: 15px;
            padding-bottom: 100px; /* 푸터 공간 */
        }

        .result-item {
            background: var(--card);
            margin-bottom: 12px;
            padding: 18px;
            border-radius: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.1s ease;
            border: 1px solid #222;
        }

        .result-item:active {
            transform: scale(0.96);
            background: #252525;
        }

        .word-info { display: flex; flex-direction: column; }

        .word-text {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 4px;
        }

        .word-meta {
            font-size: 13px;
            color: #888;
        }

        .copy-badge {
            background: #333;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            color: #00ff88;
            font-weight: bold;
        }

        /* 하단 랭킹/관리 바 (플로팅) */
        .floating-bar {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 500px;
            background: var(--primary);
            color: #000;
            padding: 12px;
            border-radius: 50px;
            text-align: center;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.3);
            cursor: pointer;
        }

        /* 복사 알림 토스트 */
        .toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary);
            color: #000;
            padding: 10px 20px;
            border-radius: 20px;
            font-weight: bold;
            display: none;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="search-wrapper">
            <input type="text" id="searchInput" placeholder="초성만 입력 (ㄱㅅㅈㅇ)" autocomplete="off">
        </div>
    </div>

    <div class="result-container" id="resultList">
        </div>

    <div class="floating-bar" onclick="location.href='#addForm'">
        새로운 단어 제보하기 +
    </div>

    <div id="toast" class="toast">복사 완료!</div>

<script type="module">
    // Firebase 설정 (기존 설정 그대로 사용)
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
    import { getFirestore, collection, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

    const firebaseConfig = { /* 유저님의 Config 입력 */ };
    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    let allWords = []; // 로컬 캐시 (속도의 핵심)

    // 1. 데이터 실시간 동기화 (최초 1회 로딩 후 로컬에서 작업)
    onSnapshot(collection(db, "words"), (snapshot) => {
        allWords = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
    });

    const searchInput = document.getElementById('searchInput');
    const resultList = document.getElementById('resultList');

    // 2. 초고속 필터링 함수 (디바운싱 없음 - 즉각 반응)
    searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (!val) {
            resultList.innerHTML = '';
            return;
        }

        // 로컬 배열에서 필터링 (서버 요청 0회)
        const filtered = allWords.filter(item => item.prefix === val);
        renderResults(filtered);
    });

    // 3. 결과 렌더링 및 클립보드 복사 연결
    function renderResults(data) {
        resultList.innerHTML = data.map(item => `
            <div class="result-item" onclick="copyToClipboard('${item.word}')">
                <div class="word-info">
                    <span class="word-text">${item.word}</span>
                    <span class="word-meta">${item.category} | ${item.word.length}글자</span>
                </div>
                <div class="copy-badge">TAP COPY</div>
            </div>
        `).join('');
    }

    // 4. 복사 함수
    window.copyToClipboard = (text) => {
        navigator.clipboard.writeText(text).then(() => {
            const toast = document.getElementById('toast');
            toast.style.display = 'block';
            setTimeout(() => toast.style.display = 'none', 1000);
        });
    };
</script>
</body>
</html>
